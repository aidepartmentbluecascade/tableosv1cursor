DATABASE_URL=postgres://tabula:tabula@localhost:5432/tabula
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000
REALTIME_PORT=3002
NODE_ENV=development
ROLE=api
WS_TICKET_SECRET=change-me-to-a-long-random-string-for-ws-tickets
MFA_ENCRYPTION_KEY=change-me-32-bytes-minimum-key!!

# Google Cloud Storage — prefer a gitignored key file under secrets/
GCS_BUCKET=your-bucket-name
GCS_PROJECT_ID=your-gcp-project-id
GCS_KEY_FILE=./secrets/gcs-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcs-service-account.json
# Or inline JSON (not recommended in committed files):
# GCS_CREDENTIALS_JSON=
# GOOGLE_CREDENTIALS_JSON=

# Optional — Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
