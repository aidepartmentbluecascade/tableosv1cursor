{
  "name": "@tabula/grid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "tabula": {
    "tier": "T2b",
    "env": "browser"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
