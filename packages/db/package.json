{
  "name": "@tabula/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "tabula": {
    "tier": "T2a",
    "env": "node"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "node -e \"process.exit(0)\"",
    "migrate": "node --import tsx src/cli/migrate.ts",
    "seed": "node --import tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@tabula/types": "workspace:*",
    "kysely": "^0.27.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@tabula/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
