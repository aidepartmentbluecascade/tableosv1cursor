{
  "name": "@tabula/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "tabula": {
    "tier": "T2a",
    "env": "node"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
